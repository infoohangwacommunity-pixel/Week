# =============================================================================
# WAXPREP - Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development and fill in values.
# NEVER commit real secrets to Git.
# =============================================================================

# --- RUNTIME ---
# Node.js environment (development | staging | production)
NODE_ENV=development

# Port for the webhook HTTP server
PORT=3000

# Logging level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- DATABASE (PostgreSQL) ---
# Full connection string with SSL enabled
DATABASE_URL=postgresql://user:password@host:5432/waxprep?sslmode=require

# Database pool configuration
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- REDIS (for BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- WHATSAPP (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_APP_SECRET=your-meta-app-secret-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=your-access-token-here

# --- AI PROVIDER ---
AI_PRIMARY_PROVIDER=anthropic
AI_PRIMARY_MODEL=claude-sonnet-4-6
AI_PRIMARY_API_KEY=sk-ant-...
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# --- QUEUE (BullMQ) ---
QUEUE_DEBOUNCE_WINDOW_MS=3000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_BASE_MS=1000
QUEUE_RETRY_DELAY_MAX_MS=60000
QUEUE_LOCK_DURATION_MS=30000

# --- RESPONSE DELIVERY ---
RESPONSE_MAX_CHUNK_CHARS=1000
RESPONSE_CHUNK_DELAY_MS=500
RESPONSE_TYPING_INDICATOR_ENABLED=true

# --- SESSION ---
SESSION_INACTIVITY_TIMEOUT_MS=1800000

# --- IDENTITY ---
# Minimum 32 bytes of entropy
PHONE_HMAC_SECRET=your-secret-pepper-for-phone-hashing-minimum-32-bytes

# --- CIRCUIT BREAKER ---
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_DURATION_MS=60000

# --- GRACEFUL SHUTDOWN ---
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- ERROR MESSAGES ---
AI_FAILURE_STUDENT_MESSAGE=Sorry, I'm having a bit of trouble right now. Could you send your message again in a moment?

# --- CONTEXT (Stage 18) ---
# Maximum recent conversation messages to include in context
CONTEXT_MAX_HISTORY_MESSAGES=20
# Maximum input tokens for AI request (includes system prompt + history + current message)
CONTEXT_MAX_INPUT_TOKENS=4000
# Token budget reserved for AI response
CONTEXT_RESPONSE_TOKEN_BUDGET=1024

# --- ORCHESTRATION (Stage 20) ---
# Fallback provider NAME (not API key!) if primary fails.
# Must be one of: fake, anthropic, openai, groq, cerebras
# Example: AI_FALLBACK_PROVIDER=cerebras
# NOTE: Put the API KEY in the provider-specific variable (e.g. AI_CEREBRAS_API_KEY),
#       NOT here. This variable takes the provider NAME only.
AI_FALLBACK_PROVIDER=
# Timeout for AI orchestration (includes context assembly + provider call)
AI_ORCHESTRATOR_TIMEOUT_MS=60000

# --- AI PROVIDER - ANTHROPIC ---
AI_ANTHROPIC_API_KEY=sk-ant-...
AI_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AI PROVIDER - OPENAI ---
AI_OPENAI_API_KEY=sk-...
AI_OPENAI_MODEL=gpt-4o

# --- AI PROVIDER - GROQ ---
AI_GROQ_API_KEY=gsk_...
AI_GROQ_MODEL=llama-3.1-70b-versatile

# --- AI PROVIDER - CEREBRAS (OpenAI-compatible) ---
# Cerebras provides an OpenAI-compatible API for fast inference
AI_CEREBRAS_API_KEY=csk_...
AI_CEREBRAS_MODEL=gpt-oss-120b

# --- AI FAKE PROVIDER (for development/testing) ---
# Set AI_PRIMARY_PROVIDER=fake to use the fake provider
AI_FAKE_RESPONSE=This is a simulated response from the Fake AI Provider.
AI_FAKE_LATENCY_MS=500
AI_FAKE_SIMULATE_FAILURE=false
AI_FAKE_FAILURE_MESSAGE=Simulated failure for testing
AI_FAKE_FAILURE_TYPE=PROVIDER_SERVER_ERROR

# --- AI SYSTEM PROMPT ---
AI_SYSTEM_PROMPT_PATH=src/ai/prompt/templates/waxprep_identity.v1.txt

# =============================================================================
# TOOLS AND RETRIEVAL (Phase G - Stages 35-40)
# =============================================================================

# Tool execution limits
TOOL_MAX_CALLS_PER_SESSION=20
TOOL_WEB_SEARCH_MAX_PER_SESSION=5
TOOL_MEMORY_SEARCH_MAX_PER_SESSION=10
TOOL_MEMORY_WRITE_MAX_PER_SESSION=10
TOOL_ASSESSMENT_GENERATE_MAX_PER_SESSION=5
TOOL_ARGUMENT_MAX_SIZE_BYTES=5120
TOOL_DEFAULT_TIMEOUT_MS=15000

# Web search configuration
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=your-web-search-api-key-here
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_RESULT_CHARS=2000
WEB_SEARCH_CACHE_TTL_SECONDS=21600
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_TRUSTED_DOMAINS=waec.gov.ng,jamb.gov.ng,neco.gov.ng,education.gov.ng

# =============================================================================
# SEMANTIC RETRIEVAL (Phase H - Stages 41-43)
# =============================================================================

# Embedding configuration
# Supported providers: openai, nomic, cohere, gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_TTL_SECONDS=86400

# For Gemini embeddings:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_API_KEY=your-gemini-api-key-here

# =============================================================================
# SAFETY AND CRISIS (Phase I - Stages 44-46)
# =============================================================================

# Safety classifier model
# This model is used for safety classification calls via the PRIMARY provider.
# If the primary provider is Groq/OpenAI/Cerebras, set this to a model that
# the primary provider serves (e.g. 'llama-3.1-8b-instant' for Groq).
# If left as the default 'claude-haiku-4-5', it will only work if the primary
# provider is Anthropic. For non-Anthropic providers, the code automatically
# falls back to AI_PRIMARY_MODEL.
SAFETY_CLASSIFIER_MODEL=claude-haiku-4-5

# Crisis detection thresholds (0.0-1.0)
SAFETY_CRISIS_LEVEL3_THRESHOLD=0.85
SAFETY_CRISIS_LEVEL2_THRESHOLD=0.55
SAFETY_INAPPROPRIATE_RESPONSE_THRESHOLD=0.80
SAFETY_ADVERSARIAL_PATTERN_THRESHOLD=0.75

# Adversarial pattern handling
SAFETY_ADVERSARIAL_DISABLE_TOOLS_AFTER=3

# Operator alerting (optional)
OPERATOR_ALERT_EMAIL=operator@example.com
OPERATOR_ALERT_WEBHOOK_URL=https://hooks.example.com/alerts

# =============================================================================
# RETRIEVAL CONFIGURATION (Phase H - Stage 43)
# =============================================================================

# Hybrid search weights (must sum to 1.0)
RETRIEVAL_HYBRID_WEIGHT_BM25=0.5
RETRIEVAL_HYBRID_WEIGHT_SEMANTIC=0.5

# HNSW index parameters (for pgvector)
RETRIEVAL_HNSW_M=16
RETRIEVAL_HNSW_EF_CONSTRUCTION=64
RETRIEVAL_HNSW_EF_SEARCH=40
RETRIEVAL_MAX_RESULTS=5
RETRIEVAL_RRF_K=60

# =============================================================================
# LEARNING INTELLIGENCE (Phase F - Stages 27-34)
# =============================================================================
# RWEA (Recency-Weighted Evidence Accumulator) parameters
# See WAXPREP_TODO.md Section 2.9 for detailed explanations

# How quickly recent evidence matters more.
# 30 days = evidence halves in influence after 30 days.
MASTERY_RECENCY_HALFLIFE_DAYS=30

# How strongly hint use penalizes evidence.
# 0.3 = each hint reduces evidence weight by ~23%.
HINT_PENALTY_COEFFICIENT=0.3

# Controls how sharply mastery responds to evidence.
# Higher = more responsive to new evidence.
SENSITIVITY=2.0

# Baseline mastery for new concepts (before any evidence).
# Everyone starts with some minimal exposure.
MASTERY_BASELINE=0.10

# Time decay rate for forgetting (Ebbinghaus-inspired).
# 0.015 ≈ 46-day half-life.
DECAY_LAMBDA=0.015

# Maximum tokens for student model context in AI prompts.
# Controls how much learning data is injected into AI context.
STUDENT_MODEL_TOKEN_BUDGET=500

# Maximum age of cached snapshot before forcing refresh (hours).
# Prevents using stale student model data.
STUDENT_MODEL_SNAPSHOT_MAX_AGE_HOURS=6

# =============================================================================
# PRIVACY AND CONSENT (Stages 47-56)
# =============================================================================

CONSENT_TEXT_VERSION=1.0
DATA_RETENTION_DAYS=365
MAX_EXPORT_SIZE_MB=10

# Rate limiting configuration (per student)
RATE_LIMIT_MESSAGES_PER_MINUTE=10
RATE_LIMIT_MESSAGES_PER_DAY=200
RATE_LIMIT_BURST_ALLOWANCE=3

# Idempotency TTL (hours)
IDEMPOTENCY_TTL_HOURS=48

# =============================================================================
# BACKUP AND DISASTER RECOVERY (Stage 55)
# =============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_STORAGE_PROVIDER=b2
BACKUP_STORAGE_BUCKET=waxprep-backups
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# =============================================================================
# SECURITY (Stage 56)
# =============================================================================

HELMET_ENABLED=true
TRUST_PROXY=false

# =============================================================================
# AUDIT LOG (Stage 56)
# =============================================================================

AUDIT_LOG_ENABLED=true

# =============================================================================
# EVALUATION (Stage 48 - Prepare Now, Implement Later)
# =============================================================================

EVALUATION_ENABLED=false
EVALUATION_SAMPLE_RATE=0.05
EVALUATION_JUDGE_MODEL=claude-haiku-4-5
