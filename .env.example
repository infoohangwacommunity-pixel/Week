# =============================================================================
# WAXPREP - Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development and fill in values.
# NEVER commit real secrets to Git.
# =============================================================================

# --- RUNTIME ---
# Node.js environment (development | staging | production)
NODE_ENV=development

# Port for the webhook HTTP server
PORT=3000

# Logging level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- DATABASE (PostgreSQL) ---
# Full connection string with SSL enabled
DATABASE_URL=postgresql://user:password@host:5432/waxprep?sslmode=require

# Database pool configuration
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- REDIS (for BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- WHATSAPP (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_APP_SECRET=your-meta-app-secret-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# --- AI PROVIDER ---
AI_PRIMARY_PROVIDER=anthropic
AI_PRIMARY_MODEL=claude-sonnet-4-6
AI_PRIMARY_API_KEY=sk-ant-...
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# --- QUEUE (BullMQ) ---
QUEUE_DEBOUNCE_WINDOW_MS=3000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_BASE_MS=1000
QUEUE_RETRY_DELAY_MAX_MS=60000
QUEUE_LOCK_DURATION_MS=30000

# --- RESPONSE DELIVERY ---
RESPONSE_MAX_CHUNK_CHARS=1000
RESPONSE_TYPING_INDICATOR_ENABLED=true

# --- SESSION ---
SESSION_INACTIVITY_TIMEOUT_MS=1800000

# --- IDENTITY ---
# Minimum 32 bytes of entropy
PHONE_HMAC_SECRET=your-secret-pepper-for-phone-hashing-minimum-32-bytes

# --- CIRCUIT BREAKER ---
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_DURATION_MS=60000

# --- GRACEFUL SHUTDOWN ---
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- ERROR MESSAGES ---
AI_FAILURE_STUDENT_MESSAGE=Sorry, I'm having a bit of trouble right now. Could you send your message again in a moment?
