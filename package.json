{
  "name": "waxprep",
  "version": "0.1.0",
  "description": "AI-first WhatsApp tutoring platform for Nigerian students",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/workers/aiWorker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/workers/aiWorker.js",
    "migrate": "node infra/scripts/migrate.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "cockatiel": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.5.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "redlock": "^5.0.0-beta.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "vitest": "^3.0.7"
  },
  "license": "MIT",
  "private": true
}
